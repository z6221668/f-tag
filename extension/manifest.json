{
  "manifest_version": 3,
  "name": "f-tag",
  "version": "0.3.0",
  "description": "为知乎、V2EX 和论坛用户添加分级彩色标签，记录你对其言论的判断，再次遇见时自动提醒。数据仅保存在本机。",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "core.js",
        "adapters.js",
        "adapters/zhihu.js",
        "adapters/v2ex.js",
        "adapters/nodeseek.js",
        "adapters/linuxdo.js",
        "adapters/discuz.js",
        "adapters/chiphell.js",
        "adapters/52pojie.js",
        "adapters/hostloc.js",
        "adapters/generic.js",
        "editor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'none'; object-src 'none'"
  }
}
