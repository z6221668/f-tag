{
  "name": "f-tag",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "package": "python3 tools/package.py",
    "check": "npm run format:check && node tools/check.mjs",
    "test:performance": "node tools/benchmark.mjs",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=20"
  }
}
